@model AccessTrust.Web.ViewModels.Approvals.ResultadoAprobacionViewModel

@{
    ViewData["Title"] = "Solicitud aprobada";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Solicitud resuelta correctamente</h4>
        </div>

        <div class="card-body">
            <div class="alert alert-success">
                La solicitud fue aprobada y se generó una credencial temporal para el solicitante.
            </div>

            <dl class="row">
                <dt class="col-sm-3">Solicitud</dt>
                <dd class="col-sm-9">
                    <code>@Model.SolicitudId</code>
                </dd>

                <dt class="col-sm-3">Credencial generada</dt>
                <dd class="col-sm-9">
                    <code>@Model.CredencialId</code>
                </dd>

                <dt class="col-sm-3">Recurso</dt>
                <dd class="col-sm-9">
                    @Model.RecursoNombre
                </dd>

                <dt class="col-sm-3">Expira</dt>
                <dd class="col-sm-9">
                    @Model.ExpiresAt.ToString("yyyy-MM-dd HH:mm:ss") UTC
                </dd>

                <dt class="col-sm-3">Usos máximos</dt>
                <dd class="col-sm-9">
                    @Model.MaxUsos
                </dd>
            </dl>

            <div class="alert alert-info mt-3">
                El acceso al recurso externo debe realizarlo el solicitante desde
                <strong>Mis accesos activos</strong>.
            </div>

            <a asp-controller="Aprobaciones"
               asp-action="Index"
               class="btn btn-primary">
                Volver a solicitudes pendientes
            </a>
        </div>
    </div>
</div>