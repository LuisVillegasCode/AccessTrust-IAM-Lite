@model List<AccessTrust.Web.ViewModels.Approvals.SolicitudPendienteListItemViewModel>

@{
    ViewData["Title"] = "Solicitudes pendientes";
}

@{
    var esAdministrador = ViewBag.EsAdministrador is bool valor && valor;
}

<h1>Solicitudes pendientes</h1>

<p class="text-muted">
    @if (esAdministrador)
    {
        <span>Vista global de solicitudes pendientes del sistema.</span>
    }
    else
    {
        <span>Solicitudes pendientes asociadas a recursos bajo tu responsabilidad.</span>
    }
</p>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay solicitudes pendientes por revisar.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Recurso</th>
                <th>Solicitante</th>
                <th>Tipo</th>
                <th>Sensibilidad</th>
                <th>Duración solicitada</th>
                <th>Prioridad</th>
                <th>Fecha</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var solicitud in Model)
            {
                <tr>
                    <td>@solicitud.RecursoNombre</td>
                    <td>
                        <div class="fw-semibold">@solicitud.UsuarioNombre</div>
                        <div class="text-muted small">@solicitud.UsuarioCorreo</div>
                    </td>
                    <td>@solicitud.RecursoTipo</td>
                    <td>
                        <span class="badge bg-secondary">
                            @solicitud.RecursoSensibilidad
                        </span>
                    </td>
                    <td>@solicitud.DuracionSolicitadaMin min</td>
                    <td>@solicitud.Prioridad</td>
                    <td>@solicitud.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
                    <td>
                        <a asp-action="Details"
                           asp-route-id="@solicitud.Id"
                           class="btn btn-sm btn-primary">
                            Revisar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}