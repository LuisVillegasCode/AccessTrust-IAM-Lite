@using Microsoft.AspNetCore.Mvc.Rendering
@model AccessTrust.Web.Models.Recurso
@using AccessTrust.Web.Models

@{
    ViewData["Title"] = "Editar recurso";
}

<h2>Editar recurso digital</h2>

<p class="text-muted">
    Modifica los datos principales del recurso protegido.
</p>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">Nombre del recurso</label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Tipo" class="form-label">Tipo</label>
        <input asp-for="Tipo" class="form-control" />
        <span asp-validation-for="Tipo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Sensibilidad" class="form-label">Sensibilidad</label>
        <select asp-for="Sensibilidad"
                asp-items="Html.GetEnumSelectList<SensibilidadRecurso>()"
                class="form-select">
        </select>
        <span asp-validation-for="Sensibilidad" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ResponsableId" class="form-label">Responsable del recurso</label>
        <select asp-for="ResponsableId"
                asp-items="@(ViewBag.Aprobadores as SelectList)"
                class="form-select">
            <option value="">Seleccione un aprobador activo...</option>
        </select>
        <span asp-validation-for="ResponsableId" class="text-danger"></span>
        <div class="form-text">
            Solo se pueden asignar usuarios activos con rol Aprobador.
        </div>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Activo" class="form-check-input" />
        <label asp-for="Activo" class="form-check-label">
            Recurso activo
        </label>
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar cambios
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}