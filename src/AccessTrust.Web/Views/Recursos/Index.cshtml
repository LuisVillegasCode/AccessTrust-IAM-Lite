@model List<AccessTrust.Web.Models.Recurso>

@{
    ViewData["Title"] = "Recursos digitales";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Recursos digitales protegidos</h2>
        <p class="text-muted mb-0">
            Administración de recursos sujetos a acceso temporal.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Nuevo recurso
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay recursos registrados.
    </div>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Sensibilidad</th>
                <th>Estado</th>
                <th>Fecha de creación</th>
                <th style="width: 220px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var recurso in Model)
            {
                <tr>
                    <td>@recurso.Nombre</td>
                    <td>@recurso.Tipo</td>
                    <td>
                        <span class="badge bg-secondary">
                            @recurso.Sensibilidad
                        </span>
                    </td>
                    <td>
                        @if (recurso.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </td>
                    <td>@recurso.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@recurso.Id" class="btn btn-sm btn-outline-info">
                            Detalle
                        </a>

                        <a asp-action="Edit" asp-route-id="@recurso.Id" class="btn btn-sm btn-outline-primary">
                            Editar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}