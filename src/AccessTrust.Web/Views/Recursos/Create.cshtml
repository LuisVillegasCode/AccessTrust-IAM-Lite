@model AccessTrust.Web.Models.Recurso
@using AccessTrust.Web.Models

@{
    ViewData["Title"] = "Nuevo recurso";
}

<h2>Nuevo recurso digital</h2>

<p class="text-muted">
    Registra un recurso protegido que podrá ser solicitado por los usuarios.
</p>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">Nombre del recurso</label>
        <input asp-for="Nombre" class="form-control" placeholder="Ej. Reporte financiero mensual" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Tipo" class="form-label">Tipo</label>
        <input asp-for="Tipo" class="form-control" placeholder="Ej. Documento, Reporte, Panel, Módulo" />
        <span asp-validation-for="Tipo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Sensibilidad" class="form-label">Sensibilidad</label>
        <select asp-for="Sensibilidad"
                asp-items="Html.GetEnumSelectList<SensibilidadRecurso>()"
                class="form-select">
        </select>
        <span asp-validation-for="Sensibilidad" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Activo" class="form-check-input" />
        <label asp-for="Activo" class="form-check-label">
            Recurso activo
        </label>
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar recurso
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}