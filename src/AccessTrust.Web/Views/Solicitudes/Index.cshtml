@model List<AccessTrust.Web.ViewModels.Requests.SolicitudAccesoListItemViewModel>

@{
    ViewData["Title"] = "Mis solicitudes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Mis solicitudes de acceso</h2>
        <p class="text-muted mb-0">
            Consulta el estado de tus solicitudes de acceso temporal a recursos protegidos.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Nueva solicitud
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Todavía no has registrado solicitudes de acceso.
    </div>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Recurso</th>
                <th>Sensibilidad</th>
                <th>Duración solicitada</th>
                <th>Prioridad</th>
                <th>Estado</th>
                <th>Fecha de solicitud</th>
                <th style="width: 120px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var solicitud in Model)
            {
                <tr>
                    <td>@solicitud.RecursoNombre</td>
                    <td>
                        <span class="badge bg-secondary">
                            @solicitud.RecursoSensibilidad
                        </span>
                    </td>
                    <td>@solicitud.DuracionSolicitadaMin min</td>
                    <td>@solicitud.Prioridad</td>
                    <td>
                        @if (solicitud.Estado == AccessTrust.Web.Models.EstadoSolicitud.Pendiente)
                        {
                            <span class="badge bg-warning text-dark">Pendiente</span>
                        }
                        else if (solicitud.Estado == AccessTrust.Web.Models.EstadoSolicitud.Aprobada)
                        {
                            <span class="badge bg-success">Aprobada</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Rechazada</span>
                        }
                    </td>
                    <td>@solicitud.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@solicitud.Id" class="btn btn-sm btn-outline-info">
                            Detalle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}