@model AccessTrust.Web.ViewModels.AccessValidation.ResultadoValidacionCredencialViewModel

@{
    ViewData["Title"] = Model.Permitido ? "Acceso concedido" : "Acceso denegado";
}

@if (Model.Permitido)
{
    <h1>Acceso concedido</h1>

    <div class="alert alert-success">
        @Model.Mensaje
    </div>

    <div class="card mb-4 border-success">
        <div class="card-header">
            Contenido protegido simulado
        </div>
        <div class="card-body">
            <h4>@Model.RecursoNombre</h4>

            <p>
                Este contenido representa un recurso protegido al que solo se puede acceder
                con una credencial temporal válida emitida por AccessTrust IAM Lite.
            </p>

            <p class="text-muted">
                Acceso registrado y uso de credencial actualizado correctamente.
            </p>
        </div>
    </div>
}
else
{
    <h1>Acceso denegado</h1>

    <div class="alert alert-danger">
        @Model.Mensaje
    </div>
}

<div class="card mb-4">
    <div class="card-header">
        Detalle de validación
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Recurso</dt>
            <dd class="col-sm-9">@Model.RecursoNombre</dd>

            <dt class="col-sm-3">Tipo</dt>
            <dd class="col-sm-9">@Model.RecursoTipo</dd>

            <dt class="col-sm-3">Sensibilidad</dt>
            <dd class="col-sm-9">
                <span class="badge bg-secondary">
                    @Model.RecursoSensibilidad
                </span>
            </dd>

            @if (!string.IsNullOrWhiteSpace(Model.CredencialId))
            {
                <dt class="col-sm-3">Credencial</dt>
                <dd class="col-sm-9">@Model.CredencialId</dd>
            }

            @if (Model.ExpiresAt.HasValue)
            {
                <dt class="col-sm-3">Expira</dt>
                <dd class="col-sm-9">
                    @Model.ExpiresAt.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC
                </dd>
            }

            @if (Model.UsosRealizados.HasValue && Model.MaxUsos.HasValue)
            {
                <dt class="col-sm-3">Usos</dt>
                <dd class="col-sm-9">
                    @Model.UsosRealizados / @Model.MaxUsos
                </dd>
            }
        </dl>
    </div>
</div>

<a asp-action="Index" class="btn btn-primary">
    Volver a recursos protegidos
</a>