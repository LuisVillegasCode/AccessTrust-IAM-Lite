@model List<AccessTrust.Web.ViewModels.AccessValidation.RecursoProtegidoViewModel>

@{
    ViewData["Title"] = "Recursos protegidos";
}

<h1>Recursos protegidos simulados</h1>

<p class="text-muted">
    Estos recursos simulan servicios externos que requieren una credencial temporal emitida por AccessTrust IAM Lite.
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay recursos activos disponibles.
    </div>
}
else
{
    <div class="row">
        @foreach (var recurso in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-header">
                        @recurso.RecursoNombre
                    </div>
                    <div class="card-body">
                        <p>
                            <strong>Tipo:</strong> @recurso.RecursoTipo
                        </p>

                        <p>
                            <strong>Sensibilidad:</strong>
                            <span class="badge bg-secondary">
                                @recurso.RecursoSensibilidad
                            </span>
                        </p>

                        <a asp-action="Validar"
                           asp-route-recursoId="@recurso.RecursoId"
                           class="btn btn-primary">
                            Acceder con token
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}