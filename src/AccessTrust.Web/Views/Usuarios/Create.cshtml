@model AccessTrust.Web.ViewModels.Users.CrearUsuarioAdminViewModel
@using AccessTrust.Web.Models

@{
    ViewData["Title"] = "Crear usuario";
}

<h2>Crear usuario</h2>

<p class="text-muted">
    Registra un nuevo usuario del sistema IAM. La contraseña se almacenará hasheada y el documento será cifrado.
</p>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">Nombre completo</label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Correo" class="form-label">Correo</label>
        <input asp-for="Correo" class="form-control" type="email" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DocumentoIdentidad" class="form-label">Documento de identidad</label>
        <input asp-for="DocumentoIdentidad" class="form-control" />
        <span asp-validation-for="DocumentoIdentidad" class="text-danger"></span>
        <div class="form-text">
            Este dato será cifrado antes de almacenarse en MongoDB.
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="PasswordTemporal" class="form-label">Contraseña temporal</label>
        <input asp-for="PasswordTemporal" class="form-control" type="password" />
        <span asp-validation-for="PasswordTemporal" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmarPasswordTemporal" class="form-label">Confirmar contraseña temporal</label>
        <input asp-for="ConfirmarPasswordTemporal" class="form-control" type="password" />
        <span asp-validation-for="ConfirmarPasswordTemporal" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Estado" class="form-label">Estado de cuenta</label>
        <select asp-for="Estado"
                asp-items="Html.GetEnumSelectList<EstadoCuenta>()"
                class="form-select">
        </select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Roles</label>

        <div class="form-check">
            <input asp-for="RolSolicitante" class="form-check-input" />
            <label asp-for="RolSolicitante" class="form-check-label">
                Solicitante
            </label>
        </div>

        <div class="form-check">
            <input asp-for="RolAprobador" class="form-check-input" />
            <label asp-for="RolAprobador" class="form-check-label">
                Aprobador
            </label>
        </div>

        <div class="form-check">
            <input asp-for="RolAdministrador" class="form-check-input" />
            <label asp-for="RolAdministrador" class="form-check-label">
                Administrador
            </label>
        </div>

        <div class="form-text">
            Debe seleccionarse al menos un rol.
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Crear usuario
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}