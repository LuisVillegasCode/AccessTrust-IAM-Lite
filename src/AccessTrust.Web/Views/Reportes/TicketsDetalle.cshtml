@model AccessTrust.Web.ViewModels.Reports.ReporteDetallePaginadoViewModel<AccessTrust.Web.ViewModels.Reports.TicketDetalleReporteViewModel>

@{
    ViewData["Title"] = "Detalle de tickets";

    Dictionary<string, string> CrearRuta(int pagina)
    {
        var ruta = new Dictionary<string, string>
        {
            ["pagina"] = pagina.ToString(),
            ["tamanoPagina"] = Model.TamanoPagina.ToString()
        };

        if (Model.Filtro.FechaDesde.HasValue) 
            ruta["FechaDesde"] = Model.Filtro.FechaDesde.Value.ToString("yyyy-MM-dd");
            
        if (Model.Filtro.FechaHasta.HasValue) 
            ruta["FechaHasta"] = Model.Filtro.FechaHasta.Value.ToString("yyyy-MM-dd");

        if (!string.IsNullOrEmpty(Model.Filtro.UsuarioId)) 
            ruta["UsuarioId"] = Model.Filtro.UsuarioId;

        if (!string.IsNullOrEmpty(Model.Filtro.UsuarioTexto)) 
            ruta["UsuarioTexto"] = Model.Filtro.UsuarioTexto;

        if (!string.IsNullOrEmpty(Model.Filtro.RecursoId)) 
            ruta["RecursoId"] = Model.Filtro.RecursoId;

        if (!string.IsNullOrEmpty(Model.Filtro.EstadoTicket)) 
            ruta["EstadoTicket"] = Model.Filtro.EstadoTicket;

        if (!string.IsNullOrEmpty(Model.Filtro.SeccionesAbiertas)) 
            ruta["SeccionesAbiertas"] = Model.Filtro.SeccionesAbiertas;

        return ruta;
    }
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1">@Model.Titulo</h1>
        <p class="text-muted mb-0">@Model.Descripcion</p>
    </div>

    <a asp-controller="Reportes"
       asp-action="Index"
       asp-route-FechaDesde="@(Model.Filtro.FechaDesde?.ToString("yyyy-MM-dd"))"
       asp-route-FechaHasta="@(Model.Filtro.FechaHasta?.ToString("yyyy-MM-dd"))"
       asp-route-UsuarioId="@Model.Filtro.UsuarioId"
       asp-route-UsuarioTexto="@Model.Filtro.UsuarioTexto"
       asp-route-RecursoId="@Model.Filtro.RecursoId"
       asp-route-EstadoTicket="@Model.Filtro.EstadoTicket"
       asp-route-SeccionesAbiertas="@Model.Filtro.SeccionesAbiertas"
       class="btn btn-outline-secondary">
        Volver a reportes
    </a>
</div>

<div class="row mb-3">
    <div class="col-md-4 mb-2">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Total de registros</div>
                <h4 class="mb-0">@Model.TotalRegistros</h4>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-2">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Página actual</div>
                <h4 class="mb-0">@Model.PaginaActual de @Model.TotalPaginas</h4>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-2">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Estado de ticket</div>
                <h4 class="mb-0">@(string.IsNullOrWhiteSpace(Model.Filtro.EstadoTicket) ? "Todos" : Model.Filtro.EstadoTicket)</h4>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light">
        Registros de tickets externos
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Emitido</th>
                    <th>Expira</th>
                    <th>Consumido</th>
                    <th>Usuario</th>
                    <th>Recurso</th>
                    <th>Sensibilidad</th>
                    <th>Estado</th>
                    <th>Credencial</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Registros.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">
                            No hay tickets para los filtros seleccionados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Registros)
                    {
                        <tr>
                            <td>@(item.FechaEmision?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                            <td>@(item.FechaExpiracion?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                            <td>@(item.FechaConsumo?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                            <td>
                                <div>@item.UsuarioNombre</div>
                                <small class="text-muted">@item.UsuarioCorreo</small>
                            </td>
                            <td>
                                <div>@item.RecursoNombre</div>
                                <small class="text-muted">@item.RecursoTipo</small>
                            </td>
                            <td>@item.Sensibilidad</td>
                            <td>@item.Estado</td>
                            <td><small>@item.CredencialId</small></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-3">
    <div class="text-muted small">
        Mostrando página @Model.PaginaActual de @Model.TotalPaginas
    </div>

    <div class="btn-group">
        <a class="btn btn-outline-secondary @(Model.TienePaginaAnterior ? "" : "disabled")"
           asp-controller="Reportes"
           asp-action="TicketsDetalle"
           asp-all-route-data="CrearRuta(Model.PaginaActual - 1)">
            Anterior
        </a>

        <a class="btn btn-outline-secondary @(Model.TienePaginaSiguiente ? "" : "disabled")"
           asp-controller="Reportes"
           asp-action="TicketsDetalle"
           asp-all-route-data="CrearRuta(Model.PaginaActual + 1)">
            Siguiente
        </a>
    </div>
</div>