@model AccessTrust.Web.ViewModels.Reports.ReporteDetallePaginadoViewModel<AccessTrust.Web.ViewModels.Reports.RecursoDetalleReporteViewModel>

@{
    ViewData["Title"] = "Detalle de recursos";

    Dictionary<string, string> CrearRuta(int pagina)
    {
        var ruta = new Dictionary<string, string>
        {
            ["pagina"] = pagina.ToString(),
            ["tamanoPagina"] = Model.TamanoPagina.ToString()
        };

        if (Model.Filtro.FechaDesde.HasValue) 
            ruta["FechaDesde"] = Model.Filtro.FechaDesde.Value.ToString("yyyy-MM-dd");
            
        if (Model.Filtro.FechaHasta.HasValue) 
            ruta["FechaHasta"] = Model.Filtro.FechaHasta.Value.ToString("yyyy-MM-dd");

        if (!string.IsNullOrEmpty(Model.Filtro.RecursoId)) 
            ruta["RecursoId"] = Model.Filtro.RecursoId;

        if (!string.IsNullOrEmpty(Model.Filtro.SensibilidadRecurso)) 
            ruta["SensibilidadRecurso"] = Model.Filtro.SensibilidadRecurso;

        if (!string.IsNullOrEmpty(Model.Filtro.SeccionesAbiertas)) 
            ruta["SeccionesAbiertas"] = Model.Filtro.SeccionesAbiertas;

        return ruta;
    }
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1">@Model.Titulo</h1>
        <p class="text-muted mb-0">@Model.Descripcion</p>
    </div>

    <a asp-controller="Reportes"
       asp-action="Index"
       asp-route-FechaDesde="@(Model.Filtro.FechaDesde?.ToString("yyyy-MM-dd"))"
       asp-route-FechaHasta="@(Model.Filtro.FechaHasta?.ToString("yyyy-MM-dd"))"
       asp-route-RecursoId="@Model.Filtro.RecursoId"
       asp-route-SensibilidadRecurso="@Model.Filtro.SensibilidadRecurso"
       asp-route-SeccionesAbiertas="@Model.Filtro.SeccionesAbiertas"
       class="btn btn-outline-secondary">
        Volver a reportes
    </a>
</div>

<div class="row mb-3">
    <div class="col-md-4 mb-2">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Total de recursos</div>
                <h4 class="mb-0">@Model.TotalRegistros</h4>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-2">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Página actual</div>
                <h4 class="mb-0">@Model.PaginaActual de @Model.TotalPaginas</h4>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-2">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Sensibilidad</div>
                <h4 class="mb-0">@(string.IsNullOrWhiteSpace(Model.Filtro.SensibilidadRecurso) ? "Todas" : Model.Filtro.SensibilidadRecurso)</h4>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light">
        Inventario de recursos protegidos
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Tipo</th>
                    <th>Sensibilidad</th>
                    <th>URL</th>
                    <th>Responsable</th>
                    <th>Activo</th>
                    <th>Creado</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Registros.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            No hay recursos para los filtros seleccionados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Registros)
                    {
                        <tr>
                            <td>@item.Nombre</td>
                            <td>@item.Tipo</td>
                            <td>@item.Sensibilidad</td>
                            <td><small>@item.Url</small></td>
                            <td>
                                <div>@item.ResponsableNombre</div>
                                <small class="text-muted">@item.ResponsableCorreo</small>
                            </td>
                            <td>@(item.Activo ? "Sí" : "No")</td>
                            <td>@(item.FechaCreacion?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-3">
    <div class="text-muted small">
        Mostrando página @Model.PaginaActual de @Model.TotalPaginas
    </div>

    <div class="btn-group">
        <a class="btn btn-outline-secondary @(Model.TienePaginaAnterior ? "" : "disabled")"
           asp-controller="Reportes"
           asp-action="RecursosDetalle"
           asp-all-route-data="CrearRuta(Model.PaginaActual - 1)">
            Anterior
        </a>

        <a class="btn btn-outline-secondary @(Model.TienePaginaSiguiente ? "" : "disabled")"
           asp-controller="Reportes"
           asp-action="RecursosDetalle"
           asp-all-route-data="CrearRuta(Model.PaginaActual + 1)">
            Siguiente
        </a>
    </div>
</div>