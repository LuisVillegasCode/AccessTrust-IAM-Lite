@model AccessTrust.Web.ViewModels.Audit.IntegridadAuditoriaResultadoViewModel

@{
    ViewData["Title"] = "Verificación de integridad";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">Verificación de integridad de auditoría</h2>
            <p class="text-muted mb-0">
                Revisión de la cadena de eventos usando Seq, PrevHash y Hash.
            </p>
        </div>

        <a asp-controller="Auditoria"
           asp-action="Index"
           class="btn btn-secondary">
            Volver a auditoría
        </a>
    </div>

    @if (Model.CadenaIntegra)
    {
        <div class="alert alert-success">
            <strong>Cadena íntegra.</strong>
            @Model.MensajeGeneral
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            <strong>Integridad comprometida.</strong>
            @Model.MensajeGeneral
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Eventos verificados</h6>
                    <h3 class="mb-0">@Model.TotalEventosVerificados</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Eventos inválidos</h6>
                    <h3 class="mb-0">@Model.TotalEventosInvalidos</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Fecha de verificación UTC</h6>
                    <h5 class="mb-0">
                        @Model.VerificadoAt.ToString("yyyy-MM-dd HH:mm:ss")
                    </h5>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Eventos.Count == 0)
    {
        <div class="alert alert-info">
            No existen eventos de auditoría para verificar.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header">
                <strong>Resultado por evento</strong>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Seq</th>
                            <th>Acción</th>
                            <th>Fecha UTC</th>
                            <th>PrevHash</th>
                            <th>Hash</th>
                            <th>Estado</th>
                            <th>Mensaje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var evento in Model.Eventos)
                        {
                            <tr>
                                <td>
                                    <strong>@evento.Seq</strong>
                                </td>

                                <td>
                                    <code>@evento.Accion</code>
                                </td>

                                <td>
                                    @evento.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
                                </td>

                                <td>
                                    @if (evento.PrevHashValido)
                                    {
                                        <span class="badge bg-success">Válido</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inválido</span>
                                    }
                                </td>

                                <td>
                                    @if (evento.HashValido)
                                    {
                                        <span class="badge bg-success">Válido</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inválido</span>
                                    }
                                </td>

                                <td>
                                    @if (evento.EsValido)
                                    {
                                        <span class="badge bg-success">Íntegro</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Alterado</span>
                                    }
                                </td>

                                <td>
                                    @evento.Mensaje
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="alert alert-secondary mt-4">
        Esta verificación recalcula los hashes de los eventos y comprueba que cada
        <strong>PrevHash</strong> coincida con el hash del evento anterior. Si un evento fue modificado manualmente en MongoDB,
        la cadena debe marcarse como inconsistente.
    </div>
</div>